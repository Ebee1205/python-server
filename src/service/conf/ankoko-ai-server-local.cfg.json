{
    "environment": "local",
    "project_name": "ankoko-ai-server",
    "api_v1_str": "/api/v1",
    "host": "localhost",
    "port": 3000,
    "secret_key": "changethis-secret-key",
    "access_token_expire_minutes": 1440,

    "logger": {
        "level": "debug",
        "path": "./logs/ankoko-ai-server.log-%DATE%",
        "suffix": "%Y-%m-%d",
        "max_bytes": 10485760,
        "max_files": "3d",
        "rotation": "daily",
        "use_console": true
    },

    "llm": {
      "models": {
        "default": {
          "provider": "ollama",
          "model": "bllossom-3b"
        },
        "analyze": {
          "provider": "ollama",
          "model": "llama3.2"
        },
        "ops": {
          "provider": "ollama",
          "model": "llama3.2"
        }
      }
    },
    
    "http_config": {
      "allow_origins": ["http://localhost:3000"],
      "allow_methods": ["*"],
      "allow_headers": ["*"],
      "allow_credentials": true
    },

    "mysql": {
      "host": "localhost",
      "port": 3306,
      "user": "root",
      "password": "changethis-mysql-password",
      "db": "mydatabase"
    },

    "redis": {
      "host": "localhost",
      "port": 6379,
      "db": 0,
      "password": null
    },

    "redis_consumer": {
      "stream_key": "ankoko:ai:stream",
      "group_name": "web-group",
      "consumer_name": "web-consumer-1"
    },
    
    "rmq": {
      "host": "localhost",
      "port": 5672,
      "user": "guest",
      "password": "guest",
      "vhost": "/",
      "exchange": "my_exchange",
      "exchange_type": "direct",
      "queues": [
        { "name": "ankoko-admin-to-algo", "type": "req" },
        { "name": "ankoko-to-algo", "type": "req"},

        { "name": "ankoko-admin-from-algo", "type": "res" },
        { "name": "ankoko-from-algo", "type": "res" }
      ],
      "routing_key": "my.routing.key",
      "heartbeat": 60,
      "reconnect_delay": 5
    },

    "mqtt": {
      "host": "",
      "port": 1883,
      "keepalive": 60,
      "topics": [
      ]
    }    
}
  