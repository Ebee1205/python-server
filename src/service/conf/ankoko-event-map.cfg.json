{
  "Ankoko": {
    "redis": {
      "chat-user":          { "stream_key": "ankoko:chat:stream",          "handler": "handlers.chat.ChatMessageHandler" },
      "chat-ai":            { "stream_key": "ankoko:chat:stream",          "handler": "handlers.chat.AIMessageHandler" },
      "sandbox-lint":       { "stream_key": "ankoko-admin-from-algo",      "handler": "src.service.scripts.rmq_basic_service.forward_to_redis" },
      "sandbox-transform":  { "stream_key": "ankoko-admin-from-algo",      "handler": "src.service.scripts.rmq_basic_service.forward_to_redis" },
      "sandbox-sweep":      { "stream_key": "ankoko-admin-from-algo",      "handler": "src.service.scripts.rmq_basic_service.forward_to_redis" },
      "sandbox-single":     { "stream_key": "ankoko-admin-from-algo",      "handler": "src.service.scripts.rmq_basic_service.forward_to_redis" },
      "sandbox-batch":      { "stream_key": "ankoko-admin-from-algo",      "handler": "src.service.scripts.rmq_basic_service.forward_to_redis" }
    },
    "rmq": {
      "chat-user":          { "queue": "ankoko-from-algo",                 "handler": "src.service.scripts.rmq_basic_service.ping" }
    }
  },

  "ankoko-ai-server": {
    "redis": {
      "ops-log":            { "stream_key": "admin:ops:log",              "handler": "handlers.ops.SystemLogHandler" },
      "ops-alert":          { "stream_key": "admin:ops:alert",            "handler": "handlers.ops.AlertHandler" }
    },
    "rmq": {
      "ws-ping":            { "queue": "system-from-algo",                "handler": "handlers.ws.ws_ping" }
    }
  }
}
