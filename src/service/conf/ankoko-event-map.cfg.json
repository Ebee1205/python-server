{
  "Ankoko": {
    "redis": {
      "chat-user":          { "stream_key": "ankoko:chat:stream",          "handler": "handlers.chat.ChatMessageHandler" },
      "chat-ai":            { "stream_key": "ankoko:chat:stream",          "handler": "handlers.chat.AIMessageHandler" },
      "sandbox-lint":       { "stream_key": "ai_task_stream",      "handler": "src.service.scripts.admin_sandbox_service.lint_prompt" },
      "sandbox-transform":  { "stream_key": "ai_task_stream",      "handler": "src.service.scripts.admin_sandbox_service.transform_prompt" },
      "sandbox-sweep":      { "stream_key": "ai_task_stream",      "handler": "src.service.scripts.admin_sandbox_service.sweep_parameters" },
      "sandbox-single":     { "stream_key": "ai_task_stream",      "handler": "src.service.scripts.admin_sandbox_service.single_llm_test" },
      "sandbox-batch":      { "stream_key": "ai_task_stream",      "handler": "src.service.scripts.admin_sandbox_service.batch_llm_test" }
    },
    "rmq": {
      "chat-user":          { "queue": "ankoko-from-algo",                 "handler": "src.service.scripts.rmq_basic_service.ping" }
    }
  },

  "ankoko-ai-server": {
    "redis": {
      "ops-log":            { "stream_key": "admin:ops:log",              "handler": "handlers.ops.SystemLogHandler" },
      "ops-alert":          { "stream_key": "admin:ops:alert",            "handler": "handlers.ops.AlertHandler" }
    },
    "rmq": {
      "ws-ping":            { "queue": "system-from-algo",                "handler": "handlers.ws.ws_ping" }
    }
  }
}