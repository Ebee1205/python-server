{
  "Ankoko": {
    "redis": {
      "chat-user":   {
        "stream_key": "ankoko:chat:stream",
        "handler": "handlers.chat.ChatMessageHandler"
      },
      "chat-ai":     {
        "stream_key": "ankoko:chat:stream",
        "handler": "handlers.chat.AIMessageHandler"
      },
      "test-pong":   {
        "stream_key": "ankoko:ai:stream",
        "handler": "src.service.scripts.basic_service.handle_test_pong"
      }
    }
  },
  "ankoko-ai-server": {
    "redis": {
      "sandbox-lint": {
        "stream_key": "ankoko:ai:stream",
        "handler": "src.service.scripts.admin_sandbox_run_llm.handle_lint_event"
      },
      "sandbox-transform": {
        "stream_key": "ankoko:ai:stream",
        "handler": "src.service.scripts.admin_sandbox_run_llm.handle_transform_event"
      },
      "sandbox-sweep": {
        "stream_key": "ankoko:ai:stream",
        "handler": "src.service.scripts.admin_sandbox_run_llm.handle_sweep_event"
      },
      "sandbox-single": {
        "stream_key": "ankoko:ai:stream",
        "handler": "src.service.scripts.admin_sandbox_run_llm.handle_single_event"
      },
      "sandbox-batch": {
        "stream_key": "ankoko:ai:stream",
        "handler": "src.service.scripts.admin_sandbox_run_llm.handle_batch_event"
      },
      "test-ping": {
        "stream_key": "ankoko:ai:stream",
        "handler": "src.service.scripts.ai_basic_service.handle_test_ping"
      }
    }
  }
}
