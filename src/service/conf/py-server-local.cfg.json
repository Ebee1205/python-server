{
    "environment": "local",
    "project_name": "MyFastAPIProject",
    "api_v1_str": "/api/v1",
    "host": "localhost",
    "port": 3000,
    "secret_key": "changethis-secret-key",
    "access_token_expire_minutes": 1440,

    "logging": {
        "level": "info",
        "path": "/var/log/myapp/app.log",
        "suffix": "%Y-%m-%d",
        "max_bytes": 10485760,
        "max_files": 3,
        "rotation": "daily",
        "use_console": true
    },

    "mysql": {
      "host": "localhost",
      "port": 3306,
      "user": "root",
      "password": "changethis-mysql-password",
      "db": "mydatabase"
    },

    "redis": {
      "host": "localhost",
      "port": 6379,
      "db": 0,
      "password": null
    },

    "rmq": {
      "host": "localhost",
      "port": 5672,
      "user": "guest",
      "password": "guest",
      "vhost": "/",
      "exchange": "my_exchange",
      "exchange_type": "direct",
      "queue": "my_queue",
      "routing_key": "my.routing.key",
      "heartbeat": 60,
      "reconnect_delay": 5
    }
}
  