{
    "environment": "local",
    "project_name": "pyServer",
    "api_v1_str": "/api/v1",
    "host": "localhost",
    "port": 3000,
    "secret_key": "changethis-secret-key",
    "access_token_expire_minutes": 1440,

    "http_config": {
      "allow_origins": ["http://localhost:3000"],
      "allow_methods": ["*"],
      "allow_headers": ["*"],
      "allow_credentials": true
    },
    
    "llm": {
      "models": {
        "default": {
          "provider": "ollama",
          "model": "llama3.2"
        },
        "analyze": {
          "provider": "ollama",
          "model": "llama3.2"
        },
        "ops": {
          "provider": "ollama",
          "model": "llama3.2"
        }
      }
    },
    
    "logger": {
        "level": "debug",
        "path": "./logs/py-local-server.log-%DATE%",
        "suffix": "%Y-%m-%d",
        "max_bytes": 10485760,
        "max_files": "3d",
        "rotation": "daily",
        "use_console": true
    },

    "mysql": {
      "host": "localhost",
      "port": 3306,
      "user": "root",
      "password": "changethis-mysql-password",
      "db": "mydatabase"
    },
    
    "mqtt": {
      "host": "localhost",
      "port": 1883,
      "keepalive": 60,
      "topics": [
        "topic/input",
        "topic/output"
      ]
    }    
}
  